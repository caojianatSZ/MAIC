// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 枚举定义
// ============================================

// 用户角色
enum UserRole {
  STUDENT        // 学生
  TEACHER        // 老师（纯教学）
  PARENT         // 家长
  CITY_PARTNER   // 城市合伙人（获客+运营）
  HQ_OPS         // 总部运营
  ADMIN          // 系统管理员
}

// 城市状态
enum CityStatus {
  ACTIVE
  INACTIVE
}

// 试课线索状态
enum TrialStatus {
  NEW            // 新线索
  CONTACTED      // 已联系
  SCHEDULED      // 已安排试课
  COMPLETED      // 试课完成
  CONVERTED      // 已转化（付费）
  LOST           // 流失
}

// 约课状态
enum BookingStatus {
  PENDING        // 待确认
  CONFIRMED      // 已确认
  IN_PROGRESS    // 进行中
  COMPLETED      // 已完成
  CANCELLED      // 已取消
  NO_SHOW        // 未到场
}

// 班级类型
enum ClassType {
  ONE_V1         // 1对1
  ONE_V2         // 1对2
  ONE_V3         // 1对3
  ONE_V4         // 1对4
  ONE_VN         // 1对N
}

// 支付状态
enum PaymentStatus {
  PENDING        // 待支付
  PAID           // 已支付
  REFUNDED       // 已退款
  FAILED         // 支付失败
}

// 出勤状态
enum AttendanceStatus {
  ATTENDED       // 出勤
  ABSENT         // 缺勤
  CANCELLED      // 取消
}

// 分账状态
enum SettlementStatus {
  UNSETTLED      // 未结算
  SETTLED        // 已结算
  DISPUTED       // 有争议
}

// ============================================
// 用户模块
// ============================================

model User {
  id            String         @id @default(cuid())
  openid        String         @unique  // 微信openid
  unionid        String?        @unique  // 微信unionid（开放平台）
  nickname      String?        // 昵称
  avatarUrl     String?        @map("avatar_url")  // 头像URL
  phoneNumber   String?        @map("phone_number")  // 手机号
  email         String?        // 邮箱

  // 用户角色
  role          UserRole       @default(STUDENT)

  // 城市关联（运营角色）- 用户所属城市（作为老师/学生）
  cityId        String?        @map("city_id")
  city          City?          @relation("CityUsers", fields: [cityId], references: [id])

  // 登录信息
  lastLoginAt   DateTime?      @map("last_login_at")
  loginCount    Int            @default(0) @map("login_count")

  // 状态
  isActive      Boolean        @default(true) @map("is_active")
  isVip         Boolean        @default(false) @map("is_vip")
  vipExpireAt   DateTime?      @map("vip_expire_at")

  // 时间戳
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  // 关系
  wechatUserInfo WechatUserInfo?
  learningProgress LearningProgress[]
  diagnosisRecords DiagnosisRecord[]
  practiceRecords PracticeRecord[]
  userAchievements UserAchievement[]
  studentProfile StudentProfile?
  studyRecords StudyRecord[]
  paperCorrectionRecords PaperCorrectionRecord[]
  wrongQuestions WrongQuestion[]
  knowledgeMasteries KnowledgeMastery[]

  // 试卷组卷模块关联
  createdQuestions Question[] @relation("QuestionCreator")
  createdPapers TestPaper[] @relation("TestPaperCreator")
  diagnosisResults DiagnosisResult[] @relation("DiagnosisResultStudent")

  // 运营平台关联
  partnerOfCity      City?            @relation("CityPartner")  // 作为城市合伙人管理的城市
  leadsAsPartner     TrialLead[]      @relation("CityPartnerLeads")
  bookingsAsPartner  Booking[]        @relation("BookingCityPartner")
  assignedLeads      TrialLead[]      @relation("AssignedTeacher")
  teacherBookings    Booking[]        @relation("BookingTeacher")
  studentBookings    Booking[]        @relation("BookingStudent")
  payments           PaymentRecord[]  @relation("PaymentStudent")

  @@map("users")
}

// 微信用户详细信息
model WechatUserInfo {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  openid        String
  unionid       String?
  sessionKey    String   @map("session_key")  // 加密存储

  // 用户信息
  nickname      String?
  gender        String?  // 0:未知 1:男 2:女
  language      String?  // zh_CN, en_US等
  city          String?
  province      String?
  country       String?

  // 时间戳
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("wechat_user_info")
}

// ============================================
// 学习模块
// ============================================

// 学习进度
model LearningProgress {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  knowledgePointId  String    @map("knowledge_point_id")
  knowledgePointName String    @map("knowledge_point_name")

  // 掌握度
  masteryLevel      Int       @map("mastery_level") // 0-100
  practiceCount     Int       @default(0) @map("practice_count")  // 练习次数
  correctCount      Int       @default(0) @map("correct_count")   // 正确次数

  // 时间戳
  lastPracticedAt   DateTime? @map("last_practiced_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([userId, knowledgePointId])
  @@map("learning_progress")
}

// 课程记录
model LessonRecord {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  lessonId    String   @map("lesson_id")
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // 学习状态
  isCompleted Boolean  @default(false) @map("is_completed")
  progress    Int      @default(0)  // 0-100
  duration    Int      // 学习时长（秒）

  // 时间戳
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, lessonId])
  @@map("lesson_records")
}

// ============================================
// 诊断模块
// ============================================

model DiagnosisRecord {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")  // 可为空（未登录用户）
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // 诊断信息
  subject     String   // math, english等
  topic       String   // quadratic_function等
  quizData    Json     @map("quiz_data")   // 题目数据
  answers     Json     // 答案数据

  // 分析结果
  totalScore  Int      @map("total_score")
  analysisResult Json    @map("analysis_result")  // 分析结果

  // 生成路径
  learningPathId  String? @map("learning_path_id")  // 关联的学习路径

  // 时间戳
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("diagnosis_records")
}

// ============================================
// 练习模块
// ============================================

model PracticeRecord {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 题目信息
  questionId      String   @map("question_id")
  knowledgePointId String   @map("knowledge_point_id")
  type            String   // single, multiple, text

  // 答题信息
  userAnswer      String?  @map("user_answer")
  isCorrect       Boolean  @map("is_correct")
  timeSpent       Int?     @map("time_spent")  // 答题用时（秒）

  // 时间戳
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("practice_records")
}

// ============================================
// 内容模块
// ============================================

// 知识点
model KnowledgePoint {
  id          String   @id @default(cuid())

  // 基本信息
  identifier  String   @unique  // kf_001, kf_002等
  subject     String   // math, english等
  name        String
  description String?
  level       Int      @default(0)  // 难度等级 0-4

  // 知识图谱
  prerequisites String[] @default([])  // 前置知识点ID数组

  // 元数据
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")

  // 时间戳
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 关系
  questionKnowledgePoints QuestionKnowledgePoint[]
  classroomKnowledgePoints ClassroomKnowledgePoint[]

  @@map("knowledge_points")
}

// 题目
model Question {
  id          String   @id @default(cuid())

  // 基本信息
  identifier  String   @unique  // dq_001, pq_001等
  subject     String   // math, english等
  type        String   // single, multiple, text (旧类型标记，保留兼容)
  questionType String   @default("choice") // 统一类型: choice|fill_blank|essay|compound
  choiceMode  String?  @map("choice_mode") // single|multiple (仅 type=choice 时)
  parentId    String?  @map("parent_id")   // 自引用：复合题的子题
  sequence    Int      @default(0)         // 子题在父题中的排序
  question    String
  options     String[] @default([])
  stemHtml    String?  @map("stem_html")   // 题干 HTML（富文本版）

  // 答案
  answer      String   // 正确答案
  explanation String?

  // 来源
  source      String?                      // local|edukg|xkw|aliyun|custom
  sourceData  Json?    @map("source_data") // 原始数据（XKW HTML 等）
  sourceId    String?   @map("source_id")  // 学科网题目ID（用于去重）
  optionLayout Json?   @map("option_layout") // { columns: number }

  // 创建者
  creatorId   String?  @map("creator_id")
  creator     User?    @relation("QuestionCreator", fields: [creatorId], references: [id])
  useCount    Int      @default(0) @map("use_count")
  correctRate Float?   @map("correct_rate")

  // 关联
  knowledgePointIds String[]  @map("knowledge_point_ids")
  questionKnowledgePoints QuestionKnowledgePoint[]
  parent       Question? @relation("SubQuestions", fields: [parentId], references: [id])
  children     Question[] @relation("SubQuestions")
  paperQuestions TestPaperQuestion[]

  // 元数据
  difficulty  Int      @default(1)  // 1-5
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?

  // 时间戳
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("questions")
}

// 题目-知识点多对多关系
model QuestionKnowledgePoint {
  id                String  @id @default(cuid())
  questionId        String  @map("question_id")
  question          Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  knowledgePointId   String  @map("knowledge_point_id")
  knowledgePoint     KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@unique([questionId, knowledgePointId])
  @@map("question_knowledge_points")
}

// 课程
model Lesson {
  id          String   @id @default(cuid())

  // 基本信息
  identifier  String   @unique  // lesson_001, lesson_002等
  subject     String
  title       String
  description String?

  // 课程信息
  duration    Int      // 时长（秒）
  sceneCount  Int      @map("scene_count")  // 场景数量
  difficulty  Int      @default(2)  // 1-5
  type        String   // slide, quiz, interactive, pbl

  // 关联知识点
  knowledgePointIds String[] @map("knowledge_point_ids")

  // 元数据
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")

  // 时间戳
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 关系
  scenes      Scene[]
  lessonRecords LessonRecord[]

  @@map("lessons")
}

// 场景
model Scene {
  id          String   @id @default(cuid())
  lessonId    String   @map("lesson_id")
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // 基本信息
  identifier  String   @unique  // scene_001_001等
  type        String   // slide, quiz, interactive_simulation, pbl_activity, discussion
  title       String
  content     Json     // 场景内容
  duration    Int      // 时长（秒）

  // 元数据
  metadata    Json?
  isActive    Boolean  @default(true) @map("is_active")

  // 时间戳
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("scenes")
}

// ============================================
// 成就系统模块
// ============================================

// 成就定义
model Achievement {
  id                String   @id @default(cuid())
  identifier        String   @unique  // ach_001, ach_002等

  // 基本信息
  type              String   // habit, progress, behavior
  subject           String?  // math, english等
  knowledgePointId  String?  @map("knowledge_point_id")  // 关联知识点
  level             String   // bronze, silver, gold, diamond, king
  name              String
  description       String?
  iconUrl           String?  @map("icon_url")

  // 解锁条件（JSON格式）
  condition         Json     // {"type": "knowledge_point_mastery", "accuracy_threshold": 80, "min_questions": 5}
  points            Int      @default(0)

  // 元数据
  isActive          Boolean  @default(true) @map("is_active")
  metadata          Json?

  // 时间戳
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // 关系
  userAchievements  UserAchievement[]

  @@map("achievements")
}

// 用户成就
model UserAchievement {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievementId     String   @map("achievement_id")
  achievement       Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  // 进度
  progress          Int      @default(0)  // 0-100
  unlockedAt        DateTime? @map("unlocked_at")
  notified          Boolean  @default(false) @map("notified")

  // 时间戳
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// 学生画像
model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 学习风格（JSON格式）
  learningStyle     Json?    @map("learning_style")  // {"visual": 0.8, "auditory": 0.3, "kinesthetic": 0.6}

  // 强项弱项（JSON数组）
  strongPoints      Json?    @map("strong_points")  // ["图形思维", "应用能力"]
  weakPoints        Json?    @map("weak_points")    // ["计算准确性", "概念理解"]

  // 学习统计（JSON格式）
  studyStats        Json?    @map("study_stats")  // {"totalStudyTime": 12000, "questionsCompleted": 150, "lessonsLearned": 12}

  // 元数据
  metadata          Json?

  // 时间戳
  lastUpdated       DateTime @updatedAt @map("last_updated")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("student_profiles")
}

// 学习记录（追溯数据）
model StudyRecord {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 基本信息
  type              String   // quiz, lesson, diagnosis
  subject           String?  // math, english等
  knowledgePointId  String?  @map("knowledge_point_id")

  // 学习数据
  score             Int?
  timeSpent         Int?     @map("time_spent")  // 秒

  // 元数据
  metadata          Json?

  // 时间戳
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("study_records")
}

// ============================================
// 系统配置
// ============================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  valueType String   @map("value_type")  // string, number, boolean, json
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}

// ============================================
// AI课程生成模块
// ============================================

// AI生成的教室（课程）
model Classroom {
  id                String   @id @default(cuid())

  // 基本信息
  identifier         String   @unique  // classroom_xxx
  title              String
  description        String?
  subject            String   // math, physics, chinese等
  grade              String?  // 初一~高三

  // 分类标签
  difficulty         String?  // standard, advanced
  style              String?  // basic, applied
  versionType        String?  @map("version_type")  // basic_standard, basic_advanced等

  // 课程内容
  scenes             Json     // 场景数组
  sceneCount         Int      @map("scene_count")
  duration           Int      // 总时长（秒）

  // 生成信息
  parentTopic         String?  @map("parent_topic")  // 原始主题（用于多版本分组）
  generationMethod    String?  @map("generation_method")  // ai_generated, manually_created
  metadata            Json?    // 生成元数据（agents, duration, knowledgePointIds等）

  // 时间戳
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // 关联
  knowledgePoints    ClassroomKnowledgePoint[]

  @@index([subject, grade])
  @@index([parentTopic])
  @@index([versionType])
  @@index([createdAt])
  @@map("classrooms")
}

// Classroom与KnowledgePoint的多对多关系
model ClassroomKnowledgePoint {
  id                String   @id @default(cuid())
  classroomId       String   @map("classroom_id")
  classroom         Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  knowledgePointId  String   @map("knowledge_point_id")
  knowledgePoint    KnowledgePoint @relation(fields: [knowledgePointId], references: [id], onDelete: Cascade)

  @@unique([classroomId, knowledgePointId])
  @@index([knowledgePointId])
  @@map("classroom_knowledge_points")
}

// ============================================
// 试卷拍照批改模块
// ============================================

// 批改记录
model PaperCorrectionRecord {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject           String
  grade             String
  mode              String   // single / batch
  imageUrl          String?
  totalQuestions    Int      @map("total_questions")
  correctCount      Int      @map("correct_count")
  score             Float?
  needsReview       Boolean  @default(false) @map("needs_review")  // 是否需要人工复核
  reviewReason      String?  @map("review_reason")  // 复核原因
  lowConfidenceCount Int     @default(0) @map("low_confidence_count")  // 低置信度题目数量
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([subject])
  @@index([needsReview])  // 用于查询待复核列表
  @@map("paper_correction_records")
}

// 错题本
// 知识点掌握统计表
model KnowledgeMastery {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // eduKG 知识点
  knowledgeUri    String   @unique @map("knowledge_uri")     // eduKG 实体 URI
  knowledgeName   String   @map("knowledge_name")            // 知识点名称
  subject         String                                      // 科目
  grade           String?                                     // 年级

  // 分类信息
  classList       Json?    @map("class_list")                // [{id, label}]
  abstractMessage String?  @map("abstract_message")          // 知识点简介

  // 统计
  totalAttempts   Int      @default(0) @map("total_attempts")
  correctCount    Int      @default(0) @map("correct_count")
  wrongCount      Int      @default(0) @map("wrong_count")
  masteryLevel    String   @default("weak") @map("mastery_level")  // weak | partial | mastered
  masteryScore    Int      @default(0) @map("mastery_score")  // 0-100

  // 时间追踪
  firstAttemptAt  DateTime @default(now()) @map("first_attempt_at")
  lastAttemptAt   DateTime @default(now()) @map("last_attempt_at")
  masteredAt      DateTime? @map("mastered_at")

  // 关联错题（用于快速查询）
  relatedWrongQuestionCount Int @default(0) @map("related_wrong_question_count")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId, masteryLevel])
  @@index([userId, subject])
  @@map("knowledge_mastery")
}

model WrongQuestion {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String   @map("question_id")  // 外部题库ID
  subject          String
  questionContent  String   @map("question_content")
  studentAnswer    String?  @map("student_answer")
  correctAnswer    String?  @map("correct_answer")
  analysis         String?
  knowledgePoints  Json?    @map("knowledge_points")

  // eduKG 知识点相关
  eduKGKnowledgePoints Json?   @map("edukg_knowledge_points")  // [{uri, name, classList, abstract}]
  primaryKnowledgeUri String?  @map("primary_knowledge_uri")   // 主知识点URI

  // 标准答案相关（来自 AnswerSSE）
  standardAnswer   String?  @map("standard_answer")      // 最终答案
  examPoints       String?  @map("exam_points")          // 考点分析
  methodGuide      String?  @map("method_guide")         // 方法点拨
  detailedAnalysis String?  @map("detailed_analysis")    // 详细解析

  wrongCount       Int      @default(1) @map("wrong_count")
  mastered         Boolean  @default(false)
  needsReview      Boolean  @default(false) @map("needs_review")
  confidence       Float?

  // 掌握追踪
  masteryLevel     String   @default("weak") @map("mastery_level")  // weak | partial | mastered
  reviewCount      Int      @default(0) @map("review_count")
  lastReviewedAt   DateTime? @map("last_reviewed_at")
  masteredAt       DateTime? @map("mastered_at")

  // 巩固练习
  practiceQuestionIds Json?   @map("practice_question_ids")  // 推荐的练习题ID列表
  practiceStats       Json?   @map("practice_stats")          // 练习统计

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, subject])
  @@index([userId, mastered])
  @@index([userId, needsReview])
  @@index([userId, primaryKnowledgeUri])  // 按知识点查询
  @@index([userId, masteryLevel])  // 按掌握等级查询
  @@map("wrong_questions")
}

// ============================================
// 试卷组卷模块
// ============================================

// 试卷
model TestPaper {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  code        String   @unique  // 试卷唯一标识（6位试卷码）

  // 来源类型
  sourceType  String   @default("custom")  // custom | xkw_paper | mixed
  sourceId    String?  @map("source_id")  // 学科网试卷ID

  // 创建者
  creatorId   String   @map("creator_id")
  creator     User     @relation("TestPaperCreator", fields: [creatorId], references: [id])

  // 关联
  questions   TestPaperQuestion[]
  diagnoses   DiagnosisResult[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@index([creatorId])
  @@index([sourceType, sourceId])
  @@map("test_papers")
}

// 试卷-题目关联
model TestPaperQuestion {
  id         String   @id @default(cuid())

  paperId    String   @map("paper_id")
  paper      TestPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  points     Int      @default(1)  // 分值
  order      Int      // 题目顺序

  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([paperId, questionId])
  @@index([paperId])
  @@index([questionId])
  @@map("test_paper_questions")
}

// 诊断结果（关联试卷）
model DiagnosisResult {
  id          String   @id @default(cuid())

  // 关联试卷
  paperId     String?  @map("paper_id")
  paper       TestPaper? @relation(fields: [paperId], references: [id])

  // 学生
  studentId   String   @map("student_id")
  student     User     @relation("DiagnosisResultStudent", fields: [studentId], references: [id])

  // 结果
  score       Int      // 总分
  totalPoints Int      @map("total_points")  // 满分
  details     Json     // 每题详情

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([studentId, createdAt])
  @@index([paperId])
  @@map("diagnosis_results")
}

// 学科网 API 调用日志
model XkwApiLog {
  id          String   @id @default(cuid())

  endpoint    String   // push_question | search | get_paper | topschool | thematic
  request     Json     // 请求参数
  response    Json?    // 响应数据
  status      String   // success | error
  errorMessage String?  @map("error_message")

  // 成本追踪
  cost        Int      @default(0)  // 调用成本（分）

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([endpoint, status])
  @@index([createdAt])
  @@map("xkw_api_logs")
}

// ============================================
// 运营平台模块（v4 设计）
// ============================================

// 城市（用于多城市运营和数据隔离）
model City {
  id            String   @id @default(cuid())
  name          String   @unique  // 城市名（如"西安"）
  status        CityStatus @default(ACTIVE)

  // 关联城市合伙人（一对一，一个城市一个合伙人）
  partnerId     String?  @unique @map("partner_id")
  partner       User?    @relation("CityPartner", fields: [partnerId], references: [id])

  // 该城市的用户（老师、学生等）
  users         User[]   @relation("CityUsers")

  // 关联数据
  trialLeads    TrialLead[]
  bookings      Booking[]
  payments      PaymentRecord[]

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("cities")
}

// 试课线索
model TrialLead {
  id            String   @id @default(cuid())

  // 学生信息
  studentName   String   @map("student_name")
  parentName    String?  @map("parent_name")
  phoneNumber   String   @map("phone_number")
  grade         String?  // 年级

  // 城市和归属
  cityId        String   @map("city_id")
  city          City     @relation(fields: [cityId], references: [id])

  // 线索归属城市合伙人（原 teacherId 改为 cityPartnerId）
  cityPartnerId String   @map("city_partner_id")
  cityPartner   User     @relation("CityPartnerLeads", fields: [cityPartnerId], references: [id])

  // 试课后分配的老师
  assignedTeacherId String?  @map("assigned_teacher_id")
  assignedTeacher   User?    @relation("AssignedTeacher", fields: [assignedTeacherId], references: [id])

  // 状态
  status        TrialStatus @default(NEW)

  // 试课信息
  scheduledTime DateTime?  @map("scheduled_time")  // 计划试课时间
  trialBookings Booking[]  @relation("TrialBooking")

  // 来源渠道
  sourceChannel String?    @map("source_channel")  // 线上投放、地推、转介绍等
  sourceNotes   String?    @map("source_notes")

  // 跟进记录
  notes         Json?     // 跟进记录 [{time, content, author}]

  // 转化信息
  convertedAt   DateTime? @map("converted_at")
  lostReason    String?   @map("lost_reason")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([cityId, status])
  @@index([cityPartnerId, status])
  @@index([status])
  @@map("trial_leads")
}

// 约课记录
model Booking {
  id            String   @id @default(cuid())

  // 关联学生（用户）
  studentId     String   @map("student_id")
  student       User     @relation("BookingStudent", fields: [studentId], references: [id])

  // 关联老师
  teacherId     String   @map("teacher_id")
  teacher       User     @relation("BookingTeacher", fields: [teacherId], references: [id])

  // 关联试课线索（如果是试课）
  trialLeadId   String?  @map("trial_lead_id")
  trialLead     TrialLead? @relation("TrialBooking", fields: [trialLeadId], references: [id])

  // 城市信息
  cityId        String   @map("city_id")
  city          City     @relation(fields: [cityId], references: [id])

  // 城市合伙人（获客来源）
  cityPartnerId String   @map("city_partner_id")
  cityPartner   User     @relation("BookingCityPartner", fields: [cityPartnerId], references: [id])

  // 课程信息
  classType     ClassType @map("class_type")
  subject       String   // math, english等
  grade         String?  // 年级

  // 时间安排
  scheduledAt   DateTime @map("scheduled_at")
  duration      Int      @default(60)  // 课时长度（分钟）

  // 课程内容（AI生成）
  courseId      String?  @map("course_id")  // 关联 CourseSession
  course        CourseSession? @relation(fields: [courseId], references: [id])

  // 状态
  status        BookingStatus @default(PENDING)

  // 出勤记录
  attendanceStatus AttendanceStatus? @map("attendance_status")

  // 课堂记录
  classroomId   String?  @map("classroom_id")  // 关联 AI 生成的 Classroom
  notes         Json?    // 课堂记录、反馈等

  // 关联支付记录
  payments      PaymentRecord[] @relation("BookingPayments")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([studentId, status])
  @@index([teacherId, scheduledAt])
  @@index([cityId, status])
  @@index([cityPartnerId, status])
  @@map("bookings")
}

// 支付记录（含分账信息）
model PaymentRecord {
  id            String   @id @default(cuid())

  // 关联学生
  studentId     String   @map("student_id")
  student       User     @relation("PaymentStudent", fields: [studentId], references: [id])

  // 关联约课
  bookingId     String   @map("booking_id")
  booking       Booking  @relation("BookingPayments", fields: [bookingId], references: [id])

  // 城市信息
  cityId        String   @map("city_id")
  city          City     @relation(fields: [cityId], references: [id])

  // 金额（分）
  amount        Int      // 总金额（分）
  paidAmount    Int?     @map("paid_amount")  // 实付金额

  // 分账信息
  teacherSalary     Int?  @map("teacher_salary")  // 老师课酬（分）
  partnerCommission Int?  @map("partner_commission")  // 合伙人分成（分）
  platformRevenue   Int?  @map("platform_revenue")  // 平台收入（分）

  // 分账状态
  settlementStatus SettlementStatus? @map("settlement_status")

  // 支付状态
  status        PaymentStatus @default(PENDING)

  // 支付渠道信息
  paymentChannel String?  @map("payment_channel")  // wechat, alipay等
  transactionId String?  @map("transaction_id")   // 第三方交易ID

  // 备注
  notes         String?

  paidAt        DateTime?  @map("paid_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([studentId, status])
  @@index([bookingId])
  @@index([cityId, status])
  @@index([settlementStatus])
  @@map("payment_records")
}

// AI 课程生成会话（v2 设计）
model CourseSession {
  id            String   @id @default(cuid())

  // 基本信息
  title         String
  description   String?
  subject       String   // math, english等
  grade         String?  // 年级
  topic         String   // 课程主题

  // 生成参数
  classType     ClassType @map("class_type")
  duration      Int      @default(60)  // 目标时长（分钟）
  difficulty    Int      @default(2)  // 1-5

  // 关联知识点
  knowledgePointIds String[] @map("knowledge_point_ids")

  // 生成方式
  generationMethod String   @map("generation_method")  // ai_generated, manually_created
  generationPrompt String?  @map("generation_prompt")  // 用户输入的提示

  // 课程内容（AI生成的场景）
  scenes         Json     // 场景数组
  sceneCount     Int      @map("scene_count")

  // 课时规划
  planData       Json?    @map("plan_data")  // 教案结构、重点难点等

  // 生成状态
  isCompleted    Boolean  @default(false) @map("is_completed")

  // 元数据
  metadata       Json?

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // 关联
  bookings      Booking[]

  @@index([subject, grade])
  @@index([createdAt])
  @@map("course_sessions")
}
