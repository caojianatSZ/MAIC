/* 试课线索转化样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

/* 线索摘要 */
.lead-summary {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  margin-right: 24rpx;
}

.summary-info {
  flex: 1;
}

.student-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.contact-info {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 表单区块 */
.form-section {
  background-color: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.form-label.required::after {
  content: '*';
  color: #EF4444;
  margin-left: 4rpx;
}

/* 单选框组 */
.radio-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  color: #374151;
}

.radio-item:last-child {
  margin-bottom: 0;
}

.radio-item radio {
  margin-right: 12rpx;
}

/* 套餐卡片 */
.package-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.package-card {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  background-color: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.package-card.active {
  background-color: rgba(59, 130, 246, 0.05);
  border-color: #3B82F6;
}

.package-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 8rpx;
}

.package-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #EF4444;
  margin-bottom: 8rpx;
}

.package-desc {
  font-size: 24rpx;
  color: #6B7280;
}

/* 文本域 */
.form-textarea {
  min-height: 160rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

/* 提交区域 */
.submit-section {
  padding: 0 32rpx;
  margin-top: 48rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
  margin-bottom: 24rpx;
}

.btn-primary.disabled {
  opacity: 0.5;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: transparent;
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
}
