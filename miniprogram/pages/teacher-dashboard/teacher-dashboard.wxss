/* 老师仪表盘样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

/* 顶部区域 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
}

.greeting {
  display: flex;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  margin-right: 24rpx;
}

.greeting-text {
  flex: 1;
}

.greeting-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.greeting-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.notification-btn {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.notification-btn image {
  width: 36rpx;
  height: 36rpx;
}

.badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background-color: #EF4444;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
}

/* 统计卡片 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 24rpx 32rpx;
}

.stat-card {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.stat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.stat-icon image {
  width: 40rpx;
  height: 40rpx;
}

.stat-info {
  flex: 1;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #6B7280;
}

/* 区块 */
.section {
  margin: 0 32rpx 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.section-more {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #6B7280;
}

.section-more image {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.todo-count {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: #EF4444;
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 今日课程 */
.booking-list {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.booking-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.booking-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.booking-item:first-child {
  padding-top: 0;
}

.booking-time {
  width: 120rpx;
  text-align: center;
}

.time-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #3B82F6;
}

.time-duration {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.booking-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #E5E7EB;
  margin: 0 24rpx;
}

.booking-student {
  flex: 1;
  display: flex;
  align-items: center;
}

.student-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
}

.class-info {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.booking-status {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.booking-status.PENDING {
  background-color: rgba(245, 158, 11, 0.1);
  color: #F59E0B;
}

.booking-status.CONFIRMED {
  background-color: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
}

.booking-status.COMPLETED {
  background-color: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

/* 待办事项 */
.todo-list {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.todo-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.todo-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.todo-item:first-child {
  padding-top: 0;
}

.todo-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.todo-icon image {
  width: 32rpx;
  height: 32rpx;
}

.todo-info {
  flex: 1;
}

.todo-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 4rpx;
}

.todo-desc {
  font-size: 24rpx;
  color: #6B7280;
}

.todo-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 统计概览 */
.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.overview-item {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.overview-label {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.overview-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 12rpx;
}

.overview-trend {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.overview-trend.up {
  color: #10B981;
}

.overview-trend.down {
  color: #EF4444;
}

.overview-trend image {
  width: 20rpx;
  height: 20rpx;
  margin-right: 4rpx;
}
