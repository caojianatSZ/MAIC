<!-- 试课线索详情 -->
<view class="container" wx:if="{{!loading && lead}}">
  <!-- 状态头部 -->
  <view class="status-header status-{{lead.status}}">
    <view class="status-icon">
      <image src="/images/icon-lead-{{lead.status}}.png" mode="aspectFit" />
    </view>
    <view class="status-info">
      <view class="status-text">{{statusLabels[lead.status]}}</view>
      <view class="status-time">创建于 {{lead.createdAt}}</view>
    </view>
  </view>

  <!-- 学生信息 -->
  <view class="info-section">
    <view class="section-header">
      <view class="section-title">学生信息</view>
      <view class="edit-btn" bindtap="onEditInfo">
        <image src="/images/icon-edit.png" mode="aspectFit" />
      </view>
    </view>

    <view class="info-row">
      <view class="info-label">姓名</view>
      <view class="info-value">{{lead.studentName}}</view>
    </view>

    <view wx:if="{{lead.grade}}" class="info-row">
      <view class="info-label">年级</view>
      <view class="info-value">{{lead.grade}}</view>
    </view>

    <view wx:if="{{lead.parentName}}" class="info-row">
      <view class="info-label">家长</view>
      <view class="info-value">{{lead.parentName}}</view>
    </view>

    <view class="info-row">
      <view class="info-label">电话</view>
      <view class="info-value phone">
        {{lead.phoneNumber}}
        <image class="call-icon" src="/images/icon-phone.png" catchtap="onCall" />
      </view>
    </view>

    <view wx:if="{{lead.sourceChannel}}" class="info-row">
      <view class="info-label">来源</view>
      <view class="info-value">{{lead.sourceChannel}}</view>
    </view>
  </view>

  <!-- 试课信息 -->
  <view class="info-section" wx:if="{{lead.scheduledTime || lead.assignedTeacher}}">
    <view class="section-header">
      <view class="section-title">试课信息</view>
    </view>

    <view wx:if="{{lead.scheduledTime}}" class="info-row">
      <view class="info-label">预约时间</view>
      <view class="info-value">{{lead.scheduledTime}}</view>
    </view>

    <view wx:if="{{lead.assignedTeacher}}" class="info-row">
      <view class="info-label">分配老师</view>
      <view class="info-value">{{lead.assignedTeacher.nickname}}</view>
    </view>
  </view>

  <!-- 跟进记录 -->
  <view class="info-section" wx:if="{{lead.notes && lead.notes.length > 0}}">
    <view class="section-header">
      <view class="section-title">跟进记录</view>
      <view class="add-note-btn" bindtap="onAddNote">
        <image src="/images/icon-add.png" mode="aspectFit" />
        添加
      </view>
    </view>

    <view class="notes-list">
      <view class="note-item" wx:for="{{lead.notes}}" wx:key="index">
        <view class="note-time">{{item.timestamp}}</view>
        <view class="note-content">{{item.content}}</view>
      </view>
    </view>
  </view>

  <!-- 操作区 -->
  <view class="action-section">
    <block wx:if="{{lead.status === 'NEW'}}">
      <button class="action-btn primary" bindtap="onContact">标记已联系</button>
      <button class="action-btn secondary" bindtap="onBookTrial">预约试课</button>
    </block>

    <block wx:elif="{{lead.status === 'CONTACTED'}}">
      <button class="action-btn primary" bindtap="onBookTrial">预约试课</button>
      <button class="action-btn secondary" bindtap="onAddNote">添加备注</button>
    </block>

    <block wx:elif="{{lead.status === 'SCHEDULED'}}">
      <button class="action-btn primary" bindtap="onCompleteTrial">完成试课</button>
      <button class="action-btn danger" bindtap="onCancelTrial">取消试课</button>
    </block>

    <block wx:elif="{{lead.status === 'COMPLETED'}}">
      <button class="action-btn success" bindtap="onConvert">转化成交</button>
      <button class="action-btn danger" bindtap="onMarkLost">标记流失</button>
    </block>

    <button wx:if="{{lead.status !== 'CONVERTED' && lead.status !== 'LOST'}}" class="action-btn text" bindtap="onDelete">删除线索</button>
  </view>
</view>

<!-- 加载状态 -->
<view wx:if="{{loading}}" class="loading">
  <view class="loading-spinner"></view>
</view>
