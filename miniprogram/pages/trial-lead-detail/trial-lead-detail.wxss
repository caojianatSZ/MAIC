/* 试课线索详情样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

/* 状态头部 */
.status-header {
  display: flex;
  align-items: center;
  padding: 48rpx 32rpx;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--status-color-light) 0%, var(--status-color) 100%);
}

.status-header.status-NEW {
  --status-color: #3B82F6;
  --status-color-light: #60A5FA;
}

.status-header.status-CONTACTED {
  --status-color: #F59E0B;
  --status-color-light: #FBBF24;
}

.status-header.status-SCHEDULED {
  --status-color: #A855F7;
  --status-color-light: #C084FC;
}

.status-header.status-COMPLETED {
  --status-color: #10B981;
  --status-color-light: #34D399;
}

.status-header.status-CONVERTED {
  --status-color: #059669;
  --status-color-light: #10B981;
}

.status-header.status-LOST {
  --status-color: #EF4444;
  --status-color-light: #F87171;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.status-icon image {
  width: 48rpx;
  height: 48rpx;
}

.status-info {
  flex: 1;
}

.status-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.status-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 信息区块 */
.info-section {
  background-color: #FFFFFF;
  margin: 0 32rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #F3F4F6;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.edit-btn {
  width: 40rpx;
  height: 40rpx;
}

.edit-btn image {
  width: 100%;
  height: 100%;
}

.add-note-btn {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #3B82F6;
}

.add-note-btn image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.info-value.phone {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.call-icon {
  width: 48rpx;
  height: 48rpx;
  padding: 8rpx;
  background-color: #10B981;
  border-radius: 50%;
}

/* 跟进记录 */
.notes-list {
  margin-top: 16rpx;
}

.note-item {
  padding: 24rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.note-item:last-child {
  margin-bottom: 0;
}

.note-time {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 12rpx;
}

.note-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

/* 操作区 */
.action-section {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0;
}

.action-btn.primary {
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
}

.action-btn.secondary {
  background-color: #F3F4F6;
  color: #3B82F6;
}

.action-btn.success {
  background-color: #10B981;
  color: #FFFFFF;
}

.action-btn.danger {
  background-color: #EF4444;
  color: #FFFFFF;
}

.action-btn.text {
  background-color: transparent;
  color: #9CA3AF;
  height: 72rpx;
  line-height: 72rpx;
}
