/* 约课详情样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

/* 状态头部 */
.status-header {
  padding: 48rpx 32rpx;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--status-color-light) 0%, var(--status-color) 100%);
}

.status-header.status-PENDING {
  --status-color: #F59E0B;
  --status-color-light: #FBBF24;
}

.status-header.status-CONFIRMED {
  --status-color: #3B82F6;
  --status-color-light: #60A5FA;
}

.status-header.status-COMPLETED {
  --status-color: #10B981;
  --status-color-light: #34D399;
}

.status-header.status-CANCELLED {
  --status-color: #EF4444;
  --status-color-light: #F87171;
}

.status-text {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 信息区块 */
.info-section {
  background-color: #FFFFFF;
  margin: 0 32rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

/* 学生卡片 */
.student-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 8rpx;
}

.student-phone {
  font-size: 26rpx;
  color: #6B7280;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 140rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

/* 备注 */
.notes-content {
  padding: 24rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

/* 操作按钮 */
.action-section {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
}

.action-btn.secondary {
  background-color: #F3F4F6;
  color: #3B82F6;
}
