/* 试课线索列表样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 120rpx;
}

/* 筛选栏 */
.filter-bar {
  background-color: #FFFFFF;
  padding: 24rpx 32rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-tabs {
  display: flex;
  gap: 24rpx;
  overflow-x: scroll;
  white-space: nowrap;
  scrollbar-width: none;
}

.filter-tabs::-webkit-scrollbar {
  display: none;
}

.filter-tab {
  position: relative;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  transition: all 0.3s ease;
}

.filter-tab.active {
  color: #3B82F6;
  font-weight: 600;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #3B82F6;
  border-radius: 2rpx;
}

.tab-count {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background-color: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
  font-size: 20rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  margin-left: 8rpx;
}

/* 搜索栏 */
.search-bar {
  background-color: #FFFFFF;
  padding: 16rpx 32rpx 24rpx;
}

.search-input {
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #F3F4F6;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.search-input input::placeholder {
  color: #9CA3AF;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.5;
}

/* 线索列表 */
.lead-list {
  padding: 24rpx 32rpx;
}

.lead-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
  position: relative;
  overflow: hidden;
  animation: scaleIn 0.3s ease-out;
}

.lead-status {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.lead-status.status-NEW {
  background-color: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
}

.lead-status.status-CONTACTED {
  background-color: rgba(245, 158, 11, 0.1);
  color: #F59E0B;
}

.lead-status.status-SCHEDULED {
  background-color: rgba(168, 85, 247, 0.1);
  color: #A855F7;
}

.lead-status.status-COMPLETED {
  background-color: rgba(16, 185, 129, 0.1);
  color: #10B981;
}

.lead-status.status-CONVERTED {
  background-color: rgba(16, 185, 129, 0.15);
  color: #059669;
}

.lead-status.status-LOST {
  background-color: rgba(239, 68, 68, 0.1);
  color: #EF4444;
}

.lead-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-right: 100rpx;
}

.student-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.lead-time {
  font-size: 24rpx;
  color: #9CA3AF;
}

.lead-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.info-label {
  color: #9CA3AF;
  margin-right: 8rpx;
  min-width: 80rpx;
}

.phone-text {
  color: #3B82F6;
  flex: 1;
}

.call-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 8rpx;
}

.lead-source {
  margin-top: 16rpx;
}

.source-tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background-color: #F3F4F6;
  color: #6B7280;
  font-size: 24rpx;
  border-radius: 16rpx;
}

/* 操作按钮 */
.lead-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  padding: 0;
}

.action-btn.primary {
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
}

.action-btn.secondary {
  background-color: #F3F4F6;
  color: #3B82F6;
}

.action-btn.success {
  background-color: #10B981;
  color: #FFFFFF;
}

.action-btn.danger {
  background-color: #EF4444;
  color: #FFFFFF;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 80rpx;
  margin-top: 24rpx;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 悬浮按钮 */
.fab-add {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  animation: float 3s ease-in-out infinite;
}

.fab-add:active {
  transform: scale(0.95);
}

.fab-icon {
  width: 48rpx;
  height: 48rpx;
}
