<!-- 约课列表 -->
<view class="container">
  <!-- 顶部筛选 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <view
        wx:for="{{statusTabs}}"
        wx:key="key"
        class="filter-tab {{currentStatus === item.key ? 'active' : ''}}"
        bindtap="onStatusChange"
        data-status="{{item.key}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 日历视图切换 -->
  <view class="view-switch">
    <view class="switch-btn {{viewMode === 'list' ? 'active' : ''}}" bindtap="onSwitchView" data-mode="list">
      <image src="/images/icon-list.png" mode="aspectFit" />
      <text>列表</text>
    </view>
    <view class="switch-btn {{viewMode === 'calendar' ? 'active' : ''}}" bindtap="onSwitchView" data-mode="calendar">
      <image src="/images/icon-calendar.png" mode="aspectFit" />
      <text>日历</text>
    </view>
  </view>

  <!-- 列表视图 -->
  <view wx:if="{{viewMode === 'list'}}" class="booking-list">
    <view
      wx:for="{{bookings}}"
      wx:key="id"
      class="booking-card"
      bindtap="onBookingTap"
      data-id="{{item.id}}"
    >
      <!-- 状态标签 -->
      <view class="booking-status status-{{item.status}}">
        {{statusLabels[item.status]}}
      </view>

      <!-- 时间 -->
      <view class="booking-time">
        <image class="time-icon" src="/images/icon-time.png" mode="aspectFit" />
        <text>{{item.scheduledAt}}</text>
      </view>

      <!-- 学生信息 -->
      <view class="booking-student">
        <image class="student-avatar" src="{{item.student.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
        <view class="student-info">
          <view class="student-name">{{item.student.nickname}}</view>
          <view class="class-info">{{item.subject}} · {{item.classTypeLabel}}</view>
        </view>
      </view>

      <!-- 班型和时长 -->
      <view class="booking-meta">
    <text class="class-type">{{item.classTypeLabel}}</text>
    <text class="duration">{{item.duration}}分钟</text>
  </view>

      <!-- 操作按钮 -->
      <view class="booking-actions" wx:if="{{item.status === 'PENDING'}}">
        <button class="action-btn confirm" catchtap="onConfirm" data-id="{{item.id}}">确认</button>
        <button class="action-btn cancel" catchtap="onCancel" data-id="{{item.id}}">取消</button>
      </view>
      <view class="booking-actions" wx:elif="{{item.status === 'CONFIRMED'}}">
        <button class="action-btn complete" catchtap="onComplete" data-id="{{item.id}}">完成</button>
      </view>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{bookings.length === 0 && !loading}}" class="empty-state">
      <image class="empty-icon" src="/images/empty-bookings.png" mode="aspectFit" />
      <view class="empty-text">暂无约课</view>
    </view>
  </view>

  <!-- 日历视图 -->
  <view wx:if="{{viewMode === 'calendar'}}" class="calendar-view">
    <view class="calendar-header">
      <view class="header-btn" bindtap="onPrevMonth">
        <image src="/images/icon-arrow-left.png" mode="aspectFit" />
      </view>
      <view class="header-title">{{currentMonth}}</view>
      <view class="header-btn" bindtap="onNextMonth">
        <image src="/images/icon-arrow-right.png" mode="aspectFit" />
      </view>
    </view>

    <view class="calendar-grid">
      <view class="weekday" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
      <view
        wx:for="{{calendarDays}}"
        wx:key="dateStr"
        class="day-cell {{item.isToday ? 'today' : ''}} {{item.isOtherMonth ? 'other-month' : ''}} {{item.hasBooking ? 'has-booking' : ''}}"
        bindtap="onDayTap"
        data-date="{{item.dateStr}}"
      >
        <view class="day-number">{{item.day}}</view>
        <view wx:if="{{item.bookingCount > 0}}" class="booking-count">{{item.bookingCount}}</view>
      </view>
    </view>

    <!-- 选中日期的约课 -->
    <view wx:if="{{selectedDateBookings.length > 0}}" class="selected-date-bookings">
      <view class="date-title">{{selectedDate}} 的约课</view>
      <view class="mini-booking" wx:for="{{selectedDateBookings}}" wx:key="id" bindtap="onBookingTap" data-id="{{item.id}}">
        <view class="mini-time">{{item.time}}</view>
        <view class="mini-student">{{item.student.nickname}}</view>
      </view>
    </view>
  </view>
</view>

<!-- 加载状态 -->
<view wx:if="{{loading && bookings.length === 0}}" class="loading">
  <view class="loading-spinner"></view>
</view>

<!-- 悬浮添加按钮 -->
<view class="fab-add" bindtap="onAddBooking">
  <image class="fab-icon" src="/images/icon-add.png" mode="aspectFit" />
</view>
