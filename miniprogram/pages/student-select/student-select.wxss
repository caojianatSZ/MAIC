/* 选择学生样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

/* 搜索栏 */
.search-bar {
  background-color: #FFFFFF;
  padding: 24rpx 32rpx;
}

.search-input {
  display: flex;
  align-items: center;
  height: 72rpx;
  background-color: #F3F4F6;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
}

.clear-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  opacity: 0.5;
}

/* 学生列表 */
.student-list {
  padding: 24rpx 32rpx;
}

.student-item {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
  transition: all 0.3s ease;
}

.student-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.08);
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 8rpx;
}

.student-meta {
  font-size: 24rpx;
  color: #6B7280;
}

.student-meta text {
  margin-right: 24rpx;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  padding: 8rpx;
  background-color: rgba(16, 185, 129, 0.1);
  border-radius: 50%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #6B7280;
}
