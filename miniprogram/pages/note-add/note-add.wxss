/* 添加备注样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

.form-section {
  background-color: #FFFFFF;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-textarea {
  min-height: 200rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

/* 快捷备注 */
.quick-notes {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.quick-note-tag {
  padding: 12rpx 24rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #6B7280;
}

/* 提交 */
.submit-section {
  padding: 0 32rpx;
  margin-top: 48rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
  margin-bottom: 24rpx;
}

.btn-primary.disabled {
  opacity: 0.5;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: transparent;
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
  border-radius: 48rpx;
  font-size: 28rpx;
  text-align: center;
}
