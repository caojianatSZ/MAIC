/* 组卷页面样式 */

.paper-create {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 试卷信息 */
.paper-info {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.input {
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

/* 已选题目统计 */
.selected-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 24rpx 30rpx;
}

.selected-bar .count {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.selected-bar .view-btn {
  font-size: 24rpx;
  color: #fff;
  opacity: 0.9;
}

/* 来源选择标签 */
.source-tabs {
  display: flex;
  background: #fff;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #667eea;
  font-weight: 500;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #667eea;
  border-radius: 2rpx;
}

/* 筛选条件 */
.filters {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.filter-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
}

.picker {
  flex: 1;
}

.picker-value {
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
}

.search-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 题目列表 */
.question-list {
  padding: 0 30rpx;
}

.question-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.question-content {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.question-content .index {
  font-size: 28rpx;
  color: #999;
  flex-shrink: 0;
}

.question-content .text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.question-meta {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.difficulty {
  font-size: 24rpx;
  color: #666;
}

.local-tag {
  font-size: 22rpx;
  color: #52c41a;
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.select-btn {
  width: 100%;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.select-btn.selected {
  background: #f5f5f5;
  color: #999;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #999;
}

.empty .hint {
  display: block;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 16rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  font-size: 28rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #ccc;
}

/* 已选题目弹窗 */
.selected-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-header .title {
  font-size: 32rpx;
  font-weight: 500;
}

.modal-header .close {
  font-size: 28rpx;
  color: #667eea;
}

.modal-body {
  flex: 1;
  padding: 30rpx;
}

.selected-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.selected-item .text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.selected-item .remove {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #ff4d4f;
  margin-left: 20rpx;
}

/* 底部操作栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
}
