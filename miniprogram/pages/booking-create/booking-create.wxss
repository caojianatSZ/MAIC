/* 创建约课样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

.form-section {
  background-color: #FFFFFF;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
}

/* 学生选择器 */
.student-selector {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.student-avatar.placeholder {
  background-color: #E5E7EB;
  padding: 16rpx;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #111827;
}

.student-phone {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-label.required::after {
  content: '*';
  color: #EF4444;
  margin-left: 4rpx;
}

.form-input {
  min-height: 80rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #111827;
  display: flex;
  align-items: center;
}

.form-input.picker::after {
  content: '';
  width: 24rpx;
  height: 24rpx;
  border-right: 3rpx solid #9CA3AF;
  border-bottom: 3rpx solid #9CA3AF;
  transform: rotate(45deg);
  margin-left: auto;
}

/* 班型选择 */
.class-type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.class-type-card {
  padding: 24rpx 16rpx;
  background-color: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.class-type-card.active {
  background-color: rgba(59, 130, 246, 0.05);
  border-color: #3B82F6;
}

.type-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 4rpx;
}

.type-desc {
  font-size: 22rpx;
  color: #6B7280;
}

/* 时长选择 */
.duration-options {
  display: flex;
  gap: 16rpx;
}

.duration-option {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background-color: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #374151;
}

.duration-option.active {
  background-color: #3B82F6;
  border-color: #3B82F6;
  color: #FFFFFF;
}

/* 提交 */
.submit-section {
  padding: 0 32rpx;
  margin-top: 48rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
}

.btn-primary.disabled {
  opacity: 0.5;
}
