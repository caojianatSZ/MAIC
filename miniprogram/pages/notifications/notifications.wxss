/* 通知列表样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  background-color: #FFFFFF;
  padding: 24rpx 32rpx;
  gap: 24rpx;
  overflow-x: scroll;
  white-space: nowrap;
}

.category-tab {
  position: relative;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  transition: all 0.3s ease;
}

.category-tab.active {
  color: #3B82F6;
  font-weight: 600;
}

.category-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #3B82F6;
  border-radius: 2rpx;
}

.badge {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  background-color: #EF4444;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  margin-left: 8rpx;
}

/* 通知列表 */
.notification-list {
  padding: 24rpx 32rpx;
}

.notification-item {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
  position: relative;
}

.notification-item.read {
  opacity: 0.6;
}

.notification-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.notification-icon image {
  width: 40rpx;
  height: 40rpx;
}

.notification-content {
  flex: 1;
}

.notification-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #111827;
  margin-bottom: 8rpx;
}

.notification-desc {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.notification-time {
  font-size: 22rpx;
  color: #9CA3AF;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #EF4444;
  border-radius: 50%;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #6B7280;
}
