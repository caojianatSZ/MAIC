/* 完成约课样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

.form-section {
  background-color: #FFFFFF;
  margin: 24rpx 32rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 32rpx;
}

/* 出勤选项 */
.attendance-option {
  display: block;
  margin-bottom: 24rpx;
}

.attendance-option radio {
  display: none;
}

.option-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: #F9FAFB;
  border: 3rpx solid #E5E7EB;
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.option-card image {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.option-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #374151;
}

.attendance-option:checked + .option-card {
  background-color: rgba(16, 185, 129, 0.05);
  border-color: #10B981;
}

/* 表单项 */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
  font-weight: 500;
}

/* 评分标签 */
.rating-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rating-tag {
  padding: 16rpx 32rpx;
  background-color: #F3F4F6;
  border: 2rpx solid #E5E7EB;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #6B7280;
  transition: all 0.3s ease;
}

.rating-tag.active {
  background-color: rgba(59, 130, 246, 0.1);
  border-color: #3B82F6;
  color: #3B82F6;
}

/* 文本域 */
.form-textarea {
  min-height: 160rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

/* 提交 */
.submit-section {
  padding: 0 32rpx;
  margin-top: 48rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4);
}

.btn-primary.disabled {
  opacity: 0.5;
}
