/* 教师时间段设置样式 */
.container {
  min-height: 100vh;
  background-color: #F9FAFB;
  padding-bottom: 32rpx;
}

/* 提示卡片 */
.tips-card {
  display: flex;
  align-items: center;
  background-color: rgba(59, 130, 246, 0.1);
  margin: 24rpx 32rpx;
  padding: 24rpx;
  border-radius: 16rpx;
}

.tips-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.tips-text {
  flex: 1;
  font-size: 26rpx;
  color: #3B82F6;
  line-height: 1.5;
}

/* 周选择器 */
.week-selector {
  background-color: #FFFFFF;
  margin: 0 32rpx 24rpx;
  border-radius: 24rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.week-scroll {
  white-space: nowrap;
}

.week-item {
  position: relative;
  display: inline-block;
  width: 120rpx;
  text-align: center;
  padding: 16rpx 0;
  margin: 0 8rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.week-item.active {
  background-color: rgba(59, 130, 246, 0.1);
}

.week-label {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.week-item.active .week-label {
  color: #3B82F6;
  font-weight: 600;
}

.week-date {
  font-size: 24rpx;
  color: #9CA3AF;
}

.slot-indicator {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  background-color: #3B82F6;
  border-radius: 50%;
}

/* 时间段区域 */
.slots-section {
  background-color: #FFFFFF;
  margin: 0 32rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.add-btn {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #3B82F6;
}

.add-btn image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 时间段卡片 */
.slot-card {
  padding: 32rpx;
  background-color: #F9FAFB;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.slot-card:last-child {
  margin-bottom: 0;
}

.slot-time {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.time-start,
.time-end {
  font-size: 48rpx;
  font-weight: 700;
  color: #3B82F6;
}

.time-separator {
  margin: 0 24rpx;
  font-size: 32rpx;
  color: #D1D5DB;
}

.slot-meta {
  margin-bottom: 24rpx;
}

.class-types {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.class-type-tag {
  padding: 8rpx 20rpx;
  background-color: rgba(59, 130, 246, 0.1);
  color: #3B82F6;
  font-size: 24rpx;
  border-radius: 24rpx;
}

.slot-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E7EB;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background-color: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #374151;
}

.action-btn.danger {
  border-color: #FECACA;
  color: #EF4444;
}

/* 空状态 */
.empty-slots {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 32rpx;
}

.quick-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
  font-size: 26rpx;
  color: #374151;
}

.quick-btn image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: all 0.3s ease;
  z-index: 1000;
}

.modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-content {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.modal.show .modal-content {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111827;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close image {
  width: 32rpx;
  height: 32rpx;
}

.modal-body {
  margin-bottom: 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 16rpx;
}

.time-picker {
  height: 80rpx;
  line-height: 80rpx;
  background-color: #F9FAFB;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  color: #111827;
}

.class-type-checkboxes {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #374151;
}

.checkbox-item checkbox {
  margin-right: 12rpx;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.modal-btn.cancel {
  background-color: #F3F4F6;
  color: #6B7280;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #3B82F6 0%, #6366F1 100%);
  color: #FFFFFF;
}
